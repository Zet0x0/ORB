#pragma code_page(65001)

#include "orbversion.h"

#if defined(__MINGW64__) || defined(__MINGW32__)
    // MinGW-w64, MinGW
    #if defined(__has_include) && __has_include(<winres.h>)
        #include <winres.h>
    #else
        #include <afxres.h>
        #include <winresrc.h>
    #endif
#else
    // MSVC, Windows SDK
    #include <winres.h>
#endif

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_ICON1 ICON ".\\style\\icons\\ORB.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
VS_VERSION_INFO VERSIONINFO
    FILEVERSION ORB_VERSION_MAJOR,ORB_VERSION_MINOR,ORB_VERSION_PATCH,0
    PRODUCTVERSION ORB_VERSION_MAJOR,ORB_VERSION_MINOR,ORB_VERSION_PATCH,0
    FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
    FILEFLAGS 0x1L
#else
    FILEFLAGS 0x0L
#endif
    FILEOS 0x40004L
    FILETYPE 0x1L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "zet0x0.com"
            VALUE "FileDescription", "Online Radio Browser & Player"
            VALUE "FileVersion", ORB_VERSION_STRING
            VALUE "InternalName", "ORB"
            VALUE "LegalCopyright", "Copyright " ORB_COPYRIGHT_YEAR " The Creator of ORB"
            VALUE "OriginalFilename", "ORB.exe"
            VALUE "ProductName", "ORB"
            VALUE "ProductVersion", ORB_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
